{
  "name": "agent-office",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit -p tests/e2e/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "test:e2e": "AGENT_OFFICE_E2E=1 bun test tests/e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
